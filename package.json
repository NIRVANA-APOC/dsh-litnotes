{
  "name": "dsh-litnotes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI-native literature workspace: local library, MinerU parsing, bilingual reading, grounded AI Q&A with clickable citations that auto-annotate the text, per-paper and library-wide knowledge graphs, and DSH agent tools over the library.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "vendor/**",
    "ui/*.js",
    "ui/*.css",
    "ui/*.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "icon": "./icon.svg"
}
